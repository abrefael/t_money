<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
	<meta charset="utf-8">
	<style>
		@page {{
			size: A4;
			margin: 50mm 15mm 25mm 15mm;

			@top-center {{
					content: element(header);
			}}

			@bottom-right {{
				content: "עמוד " counter(page) " מתוך " counter(pages);
				font-size: 9pt;
			}}
		}}
		header {{
			position: running(header);
		}}
		header table,header td{
		border-style:none;
		}}
		body {{
			font-family: "DejaVu Sans", sans-serif;
			direction: rtl;
			text-align:right;
			font-size: 12pt
		}}
		th {{
		background-color:#D2D2D2;
		}}
		table {{
			border-collapse: collapse;
			width: 100%;
		}}
		td, th {{
			border: 1px solid #D2D2D2;
			padding: 6px;
			text-align: right;
		}}
		.head1 {{
			font-size: 18pt;
			font-weight:bold;
			text-align: center;
		}}
		h1 {{
			font-size: 22pt;
		}}
		.one{{
			width:82.5%
		}}
		.two{{
			width:17.5%;
			text-align:left
		}}
		#headding{{
			text-align:center
		}}
		#head_tbl{{
			width:100%;
		}}
		#about{{
			font-size: 14pt;
			font-weight:bold;
		}}
		#signature{{
			text-align:left;
		}}
		thead {{
  display: table-header-group;
}}
tr {{
  break-inside: avoid;
}}

	</style>
</head>
<body>
<header>
<div>
<p class="head1">{company_name}</p>
<table id="head_tbl">
	<tr>
		<td>
			<table>
				<tr><td>ע.פ.:</td><td>{op_num>}</td></tr>
				<tr><td>מספר טלפון:</td><td>{phone_num}</td></tr>
				<tr><td>דואר אלקטרוני:</td><td>{email_add}</td></tr>
			</table>
		</td>
		<td style="width:15%;"><img src="{logo_img}" style="width:80px;"></td>
	</tr>
</table>
</div>
</header>
<div id="headding">
<br>
{date}
<h1>הצעת מחיר מס': {q_num}</h1>

</div>
<div id="about">
<br>
עבור: 
{client} <br><br>
ע.מ/ת.ז/ע"ר: 
{h_p}<br><br>
</div>
<br>
<table style="text-align:right;">
	<thead>
		<tr>
			<th style="width:20%;">שם פריט/מק"ט</th>
			<th style="width:35%;">תיאור</th>
			<th style="width:17%;">מחיר</th>
			<th style="width:8%;">כמות</th>
			<th class="two">לתשלום</th>
		</tr>
	</thead>
{items_data}
</table>
<table class="summ"><tr><td class="one" ></td>
		<td class="two" ></td></tr>
</table>
<table class="summ">
	<tr>
		<td class="one" >סה"כ</td>
		<td class="two" >{total} ₪</td>
	</tr>
{discount_segment}
</table>
<br><br><br>
<div id="signature">
	{signature}<br><br>
	<img src="{sign_img}" style="height:50px">
</div>
<br><br>{notes}
</body>
</html>


